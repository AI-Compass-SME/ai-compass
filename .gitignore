# ------------------------------------------------------------------------------
# Keep These Files (Whitelist)
# ------------------------------------------------------------------------------
# Ensure essential files are NOT ignored
!.gitignore
!.env.example
!infra/.env.example
!apps/web/.env.example
!requirements.txt
!README.md
!*.md
!data/questionnaire/questions.json
!apps/api/alembic/versions/001_initial_schema.py
