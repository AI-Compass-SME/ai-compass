# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicompass

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048

# ML Configuration
SYNTHETIC_PEER_COUNT=500
KMEANS_CLUSTERS=4
KMEANS_RANDOM_STATE=42

# App Configuration
QUESTIONNAIRE_PATH=../../data/questionnaire/questions.json
LOG_LEVEL=INFO

# Cache Configuration
LLM_CACHE_ENABLED=true
